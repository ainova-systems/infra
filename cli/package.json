{
  "name": "@ainova-systems/infra",
  "version": "0.5.0",
  "description": "One CLI for every host a project owns: a project manifest and lock, the pinned Ansible toolchain, generated inventory and playbooks, conformance checks, apply and check runs, and operator connections.",
  "keywords": [
    "infrastructure",
    "ansible",
    "hosts",
    "devops",
    "cli"
  ],
  "homepage": "https://github.com/ainova-systems/infra#readme",
  "bugs": {
    "url": "https://github.com/ainova-systems/infra/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainova-systems/infra.git",
    "directory": "cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "infra": "dist/bin.js"
  },
  "files": [
    "dist",
    "runner",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=4 \"src/**/*.test.ts\"",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
