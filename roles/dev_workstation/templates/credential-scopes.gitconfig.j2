# {{ ansible_managed }}
# Per-scope Git credentials. Sorted so a URL prefix precedes the longer URLs under it:
# each section resets the helper list, so the longest matching prefix alone answers.
# Helper arguments: scope name, kind (github|generic) and the username sent with the token.
{% for scope in dev_workstation__scopes[dev_workstation_account.name] | sort(attribute='url') %}
[credential "{{ scope.url }}"]
	helper =
	helper = !{{ dev_workstation_credential_helper }} {{ scope.name }} {{ scope.kind }} {{ scope.username }}
	useHttpPath = true
{% endfor %}
