# {{ ansible_managed }}
# Per-organization Git credential scopes. Sorted so a URL prefix precedes the longer URLs under it:
# each section resets the helper list, so the longest matching prefix alone answers.
{% for scope in (dev_workstation_account.credential_scopes | default(dev_workstation_default_credential_scopes)) | sort(attribute='url') %}
[credential "{{ scope.url }}"]
	helper =
	helper = !{{ dev_workstation_credential_helper }} {{ scope.name }}
	useHttpPath = true
{% endfor %}
