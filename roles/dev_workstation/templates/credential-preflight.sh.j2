#!/bin/sh
# {{ ansible_managed }}
# Read-only safety check of one account's Git credential paths. Runs as that account, never as root,
# so no account-controlled path is ever followed with administrator authority.
# Prints the failing path or setting, never file contents. Exit 0 = safe, 1 = unsafe.
# Usage: credential-preflight <managed-gitconfig-path>
set -u
managed=${1:?managed gitconfig path required}
uid=$(id -u)
status=0
fail() { printf 'credential-preflight: %s\n' "$*" >&2; status=1; }

for p in "$HOME/.config" "$HOME/.config/git" "$HOME/.config/git-credentials"; do
  if [ -L "$p" ]; then fail "symlink: $p"
  elif [ -e "$p" ]; then
    [ -d "$p" ] || fail "not a directory: $p"
    [ "$(stat -c %u "$p")" = "$uid" ] || fail "not owned by the account: $p"
  fi
done
p=$HOME/.config/git-credentials
if [ -d "$p" ] && [ ! -L "$p" ] && [ "$(stat -c %a "$p")" != 700 ]; then fail "mode is not 0700: $p"; fi

for p in "$HOME/.gitconfig" "$HOME/.config/git/config" "$managed" "$HOME/.profile"; do
  if [ -L "$p" ]; then fail "symlink: $p"
  elif [ -e "$p" ]; then
    [ -f "$p" ] || fail "not a regular file: $p"
    [ "$(stat -c %u "$p")" = "$uid" ] || fail "not owned by the account: $p"
  fi
done

# Competing stores: a plaintext Git store or a persistent gh login answers before or beside the scopes.
for p in "$HOME/.git-credentials" "$HOME/.config/git/credentials" "$HOME/.config/gh/hosts.yml"; do
  if [ -e "$p" ] || [ -L "$p" ]; then fail "competing credential store: $p"; fi
done

for p in "$HOME/.config/git-credentials"/*; do
  [ -e "$p" ] || [ -L "$p" ] || continue
  case $p in *.env) ;; *) fail "unexpected entry: $p"; continue ;; esac
  if [ -L "$p" ] || [ ! -f "$p" ]; then fail "not a regular file: $p"; continue; fi
  [ "$(stat -c %u:%a "$p")" = "$uid:600" ] || fail "not owner-only 0600: $p"
  [ "$(grep -c '^GH_TOKEN=' "$p")" = 1 ] || fail "must hold exactly one GH_TOKEN line: $p"
done

# Every credential setting must come from the managed file; anything else would add a helper to the scopes.
origins=$(cd / && git config --show-origin --get-regexp '^credential\.' 2>/dev/null | cut -f1 | sort -u)
for origin in $origins; do
  [ "$origin" = "file:$managed" ] || fail "credential setting outside the managed file: $origin"
done

exit "$status"
