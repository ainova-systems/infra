# {{ ansible_managed }}
# systemd EnvironmentFile syntax, also read by the login profile: KEY=VALUE or KEY="VALUE", no export, no expansion.
DOTNET_ROOT={{ dev_workstation_dotnet_root }}
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_NOLOGO=1
COREPACK_ENABLE_DOWNLOAD_PROMPT=0
COREPACK_DEFAULT_TO_LATEST=0
{% for name, value in dev_workstation_environment | dictsort %}
{{ name }}="{{ value }}"
{% endfor %}
