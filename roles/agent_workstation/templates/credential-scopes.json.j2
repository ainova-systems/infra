{#- Non-secret: which credential scopes each coding account may store with agent-auth. -#}
{%- set data = {} -%}
{%- for account in agent_workstation_accounts -%}
{%-   set scopes = [] -%}
{%-   for scope in account.credential_scopes | default(agent_workstation_default_credential_scopes) -%}
{%-     set entry = {'name': scope.name, 'url': scope.url} -%}
{%-     if scope.validate_url is defined -%}{%- set _ = entry.update({'validate_url': scope.validate_url}) -%}{%- endif -%}
{%-     set _ = scopes.append(entry) -%}
{%-   endfor -%}
{%-   set _ = data.update({account.name: scopes}) -%}
{%- endfor -%}
{{ data | to_nice_json(indent=2) }}
