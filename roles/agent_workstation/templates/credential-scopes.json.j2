{#- Non-secret: which credential scopes each coding account may store with agent-auth, kind and username resolved. -#}
{%- set data = {} -%}
{%- for account in agent_workstation_accounts -%}
{%-   set _ = data.update({account.name: agent_workstation__scopes[account.name]}) -%}
{%- endfor -%}
{{ data | to_nice_json(indent=2) }}
