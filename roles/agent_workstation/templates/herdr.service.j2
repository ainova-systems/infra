# Managed by the agent_workstation role; local edits are overwritten.
[Unit]
Description=Herdr persistent coding-agent console
After=network-online.target

[Service]
Type=simple
WorkingDirectory={{ agent_workstation__herdr_workdir }}
Environment=PATH={{ agent_workstation_herdr_path }}
{% if agent_workstation_herdr_rootless_docker %}
Environment=DOCKER_HOST=unix://%t/docker.sock
{% endif %}
Environment=TERM=xterm-256color
UMask=0077
ExecStart=%h/.local/bin/herdr server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
