# {{ ansible_managed }}
[Unit]
Description=Update the coding-agent CLIs on the {{ coding_agent_updates_channel }} channel without restarting sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ coding_agent_updates_command }}
TimeoutStartSec={{ coding_agent_updates_timeout }}
UMask=0022
