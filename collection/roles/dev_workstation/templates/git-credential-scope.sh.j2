#!/bin/sh
# {{ ansible_managed }}
# Git credential helper for one credential scope. Git selects the scope by URL prefix
# (credential.<url>.helper); this helper only reads the calling account's own token file for it.
# Usage (by Git): git-credential-scope <scope> <kind> <username> get
#   kind: github | generic. The two-argument form <scope> get, written before 0.2.0, is a github scope.
# Token file: ~/.config/git-credentials/<scope>.env with exactly one TOKEN= line; a github scope also
# accepts one legacy GH_TOKEN= line, never both.
set -eu
scope=${1:-}
case $# in
  2) kind=github; username=x-access-token; action=$2 ;;
  4) kind=$2; username=$3; action=$4 ;;
  *) kind=; username=; action= ;;
esac
# Git writes the request on stdin; consume it so Git never sees a broken pipe.
protocol=
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  [ "$key" != protocol ] || protocol=$value
done
[ "$action" = get ] || exit 0
[ "$protocol" = https ] || exit 0
case $scope in
  ''|-*|*[!a-z0-9-]*) exit 0 ;;
esac
case $kind in
  github|generic) ;;
  *) exit 0 ;;
esac
case $username in
  ''|-*|*[!A-Za-z0-9._@+-]*) exit 0 ;;
esac
file=$HOME/.config/git-credentials/$scope.env
# Owner-only regular file, never a link: anything else is ignored rather than trusted.
[ -f "$file" ] && [ ! -L "$file" ] || exit 0
[ "$(stat -c %u:%a "$file")" = "$(id -u):600" ] || exit 0
# Only the scope file: an inherited environment token would otherwise answer for every scope.
current=$(grep -c '^TOKEN=' "$file" || true)
legacy=$(grep -c '^GH_TOKEN=' "$file" || true)
if [ "$current" = 1 ] && [ "$legacy" = 0 ]; then
  token=$(sed -n 's/^TOKEN=//p' "$file")
elif [ "$kind" = github ] && [ "$current" = 0 ] && [ "$legacy" = 1 ]; then
  token=$(sed -n 's/^GH_TOKEN=//p' "$file")
else
  exit 0
fi
case $token in
  \"*\") token=${token#\"}; token=${token%\"} ;;
  \'*\') token=${token#\'}; token=${token%\'} ;;
esac
[ -n "$token" ] || exit 0
printf 'username=%s\npassword=%s\n' "$username" "$token"
